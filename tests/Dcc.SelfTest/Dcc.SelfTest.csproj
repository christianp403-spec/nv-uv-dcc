<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>NvUv.Dcc.SelfTest</RootNamespace>
    <AssemblyName>Dcc.SelfTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Dcc.Core\Dcc.Core.csproj" />
    <ProjectReference Include="..\..\src\Dcc.Helper\Dcc.Helper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\Dcc.App\Data\GameDatabase.json" Link="Data\GameDatabase.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
