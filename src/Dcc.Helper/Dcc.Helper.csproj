    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>NvUv.Dcc.Helper</RootNamespace>
    <AssemblyName>Dcc.Helper</AssemblyName>
