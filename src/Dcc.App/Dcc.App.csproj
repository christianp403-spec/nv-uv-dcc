<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>NvUv.Dcc.App</RootNamespace>
    <AssemblyName>DCC-by-NV-UV</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dcc.Core\Dcc.Core.csproj" />
    <ProjectReference Include="..\Dcc.Helper\Dcc.Helper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\brushed_silver.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\tray_active.ico" />
    <Resource Include="Assets\tray_off.ico" />
    <Resource Include="Assets\tray_recovery.ico" />
  </ItemGroup>
  <Target Name="CopyDccHelper" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <DccHelperFiles Include="..\Dcc.Helper\bin\$(Configuration)\net10.0-windows\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DccHelperFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(OutDir)Microsoft.Diagnostics.Tracing.TraceEvent.dll')"
           Text="The DCC helper ETW runtime dependency was not copied to the app output." />
  </Target>
</Project>
