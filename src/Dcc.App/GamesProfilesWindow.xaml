<Window x:Class="NvUv.Dcc.App.GamesProfilesWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="360"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PolishedMetalBrush}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="12" Icon="/Assets/app.ico">
    <Window.Resources>
        <Style x:Key="HistoryRowStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkHistoryScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="#FF090909" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28" Margin="2,1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBody" Background="#FF454545" CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource NvGreen}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryListStyle" TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                            <ScrollViewer CanContentScroll="True" Focusable="False">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="9" />
                                            </Grid.ColumnDefinitions>
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                                    ClipToBounds="True"
                                                                    Content="{TemplateBinding Content}" />
                                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                                       Style="{StaticResource DarkHistoryScrollBar}"
                                                       Orientation="Vertical"
                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Fill" StretchDirection="Both">
        <Grid Width="640" Height="360">
            <Rectangle Fill="{StaticResource PolishedMetalBrush}" IsHitTestVisible="False" />
            <Rectangle Fill="{StaticResource BrushedSilverBrush}" IsHitTestVisible="False" />
            <Rectangle Fill="{StaticResource PolishedSheenBrush}" IsHitTestVisible="False" />
            <Border BorderBrush="#8A111111" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="37" />
                    </Grid.RowDefinitions>

                    <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TitleBarText" Text="DCC · Dynamic Clock Capping" Margin="11,0,0,0" VerticalAlignment="Center"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" />
                        <Button Grid.Column="1" Style="{StaticResource CloseChromeButton}"
                                Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Click="CloseButton_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,5,12,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="31" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="HistoryTitleText" Text="Activated history" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="HistorySubtitleText" Text="Only games DCC has actually controlled"
                                           FontSize="8" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="2,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LanguageLabelText" Text="LANGUAGE" FontFamily="Consolas" FontSize="7"
                                           Foreground="{StaticResource TextMuted}" />
                                <ComboBox x:Name="LanguageComboBox" Style="{StaticResource OledComboBox}"
                                          Height="21" SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="de" Content="DE" />
                                    <ComboBoxItem Tag="en" Content="EN" />
                                    <ComboBoxItem Tag="ru" Content="RU" />
                                    <ComboBoxItem Tag="es" Content="ES" />
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="PerformanceLoggingCheckBox"
                                      Style="{StaticResource OledToggleSwitch}" Height="34"
                                      Content="Record performance logs" FontSize="11"
                                      Click="PerformanceLoggingCheckBox_Click"
                                      ToolTip="Off by default. Records a no-control baseline while DCC is off and method runs while DCC is on. Requires UAC for the read-only ETW monitor." />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SearchLabelText" Text="SEARCH" FontFamily="Consolas" FontSize="8"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource OledTextBox}"
                                     Height="25" HorizontalContentAlignment="Left"
                                     ToolTip="Filter by game, executable, NVIDIA profile, or DCC method."
                                     TextChanged="SearchBox_TextChanged" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="10,0,19,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="0.92*" />
                                <ColumnDefinition Width="1.18*" />
                                <ColumnDefinition Width="0.72*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GameHeaderText" Text="GAME / EXE" FontFamily="Consolas" FontSize="7"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock x:Name="LastSetupHeaderText" Grid.Column="1" Text="LAST SETUP" FontFamily="Consolas" FontSize="7"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock x:Name="LearnedHeaderText" Grid.Column="2" Text="LEARNED" FontFamily="Consolas" FontSize="7"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock x:Name="LastUsedHeaderText" Grid.Column="3" Text="LAST USED" FontFamily="Consolas" FontSize="7"
                                       Foreground="{StaticResource TextMuted}" />
                        </Grid>

                        <Border Grid.Row="3" Background="{StaticResource PolishedCardBrush}"
                                BorderBrush="{StaticResource OledBorder}" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <ListBox x:Name="HistoryList" Style="{StaticResource HistoryListStyle}"
                                         Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource HistoryRowStyle}"
                                         SelectionChanged="HistoryList_SelectionChanged"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.35*" />
                                                    <ColumnDefinition Width="0.92*" />
                                                    <ColumnDefinition Width="1.18*" />
                                                    <ColumnDefinition Width="0.72*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Executable}" FontFamily="Consolas"
                                                               FontSize="8" Foreground="{StaticResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding LastSetup}"
                                                           FontFamily="Consolas" FontSize="9"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Learned}"
                                                           FontFamily="Consolas" FontSize="9"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding LastUsed}"
                                                           FontFamily="Consolas" FontSize="9"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="EmptyText" Text="No activated games yet."
                                           Foreground="{StaticResource TextSecondary}" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="12,0,12,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="Auto" />
                             <ColumnDefinition Width="Auto" />
                             <ColumnDefinition Width="Auto" />
                             <ColumnDefinition Width="Auto" />
                             <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CountText" FontFamily="Consolas" FontSize="8"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <Button x:Name="ResetProfileButton" Grid.Column="1" Style="{StaticResource GhostButton}" Height="25"
                                Content="Reset profile" ToolTip="Reset the selected learned profile."
                                IsEnabled="False" Click="ResetProfileButton_Click" />
                        <Button x:Name="ExportPerformanceButton" Grid.Column="2" Style="{StaticResource GhostButton}" Height="25"
                                 Content="Performance logs" ToolTip="Export recorded per-game runs and their comparison summary."
                                 Click="ExportPerformanceButton_Click" />
                        <Button x:Name="ExportProfilesButton" Grid.Column="3" Style="{StaticResource GhostButton}" Height="25"
                                 Content="Export profiles" ToolTip="Export learned DCC clock profiles as JSON."
                                 Click="ExportProfilesButton_Click" />
                        <Button x:Name="ExportDiagnosticsButton" Grid.Column="4" Style="{StaticResource GhostButton}" Height="25"
                                 Content="Diagnostics" ToolTip="Export a privacy-filtered diagnostic ZIP."
                                 Click="ExportDiagnosticsButton_Click" />
                        <Button x:Name="OpenFolderButton" Grid.Column="5" Style="{StaticResource GhostButton}" Height="25"
                                Content="Data folder" ToolTip="Open DCC's local history, profiles, and logs."
                                Click="OpenFolderButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>
