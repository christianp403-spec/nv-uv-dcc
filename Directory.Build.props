<Project>
  <PropertyGroup>
    <Version>0.1.0-alpha.18-hotfix.8</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Christian (christianp403-spec)</Authors>
    <Company>NV-UV</Company>
    <Product>DCC – Dynamic Clock Capping</Product>
    <Copyright>Copyright © 2026 Christian (christianp403-spec)</Copyright>
    <RepositoryUrl>https://github.com/christianp403-spec/nv-uv-dcc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE"
          Pack="true"
          PackagePath=""
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath=""
          Visible="false" />

    <None Include="$(MSBuildThisFileDirectory)NOTICE.txt"
          Pack="true"
          PackagePath=""
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
          Pack="true"
          PackagePath=""
          Visible="false" />
  </ItemGroup>
</Project>
